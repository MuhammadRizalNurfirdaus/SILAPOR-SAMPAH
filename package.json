{
  "name": "silapor-sampah",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi SILAPOR SAMPAH - Dinas Lingkungan Hidup Kabupaten Kuningan",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:all": "concurrently -n \"frontend\" -c \"cyan\" \"npm run dev --prefix frontend\"",
    "dev-all": "npm run dev:all",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "supabase:types": "npx supabase gen types typescript --local > frontend/src/types/database.types.ts",
    "supabase:status": "npx supabase status",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supabase": "^3.2.0"
  }
}
